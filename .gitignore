# Игнорировать всё по умолчанию
*

# Но разрешить определённые папки и файлы
!src/main/java/ru/yandex/praktikum/stellar_burgers/
!src/test/java/ru/yandex/praktikum/stellar_burgers/tests/
!target/allure-results/

# Исключить пустые папки (необязательно, но полезно)
!*/**

# Разрешить файлы внутри этих папок
!src/main/java/ru/yandex/praktikum/stellar_burgers/**/*
!src/test/java/ru/yandex/praktikum/stellar_burgers/tests/**/*
!target/allure-results/**/*

# Также нужно разрешить основные файлы проекта
!pom.xml
!README.md
!.gitignore
!*.PNG

# Разрешить папку allure-report (если нужно)
!target/allure-results

# Исключить всё остальное в target, кроме разрешенного
target/*
!target/allure-report
